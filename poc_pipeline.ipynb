     "def api_tim_kiem_tai_lieu(cau_hoi, top_k=2):\n",
     "    print(f\"\\n===========================================\")\n",
     "    print(f\"Câu hỏi: '{cau_hoi}'\")\n",
     "    print(f\"===========================================\")\n",
     "\n",
     "    query_vector = embedding_model.encode(cau_hoi).tolist()\n",
     "    ket_qua = collection.query(query_embeddings=[query_vector], n_results=top_k)\n",
     "\n",
     "    for i, (doc, khoang_cach) in enumerate(zip(ket_qua['documents'][0], ket_qua['distances'][0])):\n",
     "        print(f\"\\n[Kết quả Top {i+1}] (Khoảng cách vector: {round(khoang_cach, 4)})\")\n",
     "        print(f\"Nội dung: {doc}\")\n",
     "\n",
     "# --- BẮT ĐẦU CHẠY KIỂM THỬ ---\n",
     "\n",
     "# Câu 1: Hỏi về giấy tờ (kiểm tra khả năng tìm chi tiết điều kiện)\n",
     "api_tim_kiem_tai_lieu(\"Sinh viên khuyết tật thì cần nộp những giấy tờ gì?\", top_k=2)\n",
     "\n",
     "# Câu 2: Hỏi về mốc thời gian (kiểm tra khả năng tìm thông tin ngày tháng)\n",
     "api_tim_kiem_tai_lieu(\"Hạn chót nộp hồ sơ miễn giảm học phí là ngày nào và nộp ở đâu?\", top_k=2)\n",
