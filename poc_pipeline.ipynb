    "source": [
     "import os\n",
     "\n",
     "# 1. Di chuyển vào thư mục repo\n",
     "%cd /content/datn-rag-chunking\n",
     "\n",
     "# 2. Đóng gói mã nguồn của luồng PoC RAG hoàn chỉnh vào một file python\n",
     "poc_code = \"\"\"import chromadb\n",
     "from sentence_transformers import SentenceTransformer\n",
     "\n",
     "# 1. Khởi tạo mô hình bge-m3\n",
     "print(\"Đang tải mô hình bge-m3...\")\n",
     "embedding_model = SentenceTransformer('BAAI/bge-m3')\n",
     "print(\"-> Tải mô hình thành công!\")\n",
     "\n",
     "# 2. Khởi tạo ChromaDB\n",
     "print(\"\\nĐang khởi tạo Vector Database (ChromaDB)...\")\n",
     "chroma_client = chromadb.Client()\n",
     "\n",
     "collection_name = \"poc_van_ban_hoc_vu\"\n",
     "if collection_name in [c.name for c in chroma_client.list_collections()]:\n",
     "    chroma_client.delete_collection(name=collection_name)\n",
     "\n",
     "collection = chroma_client.create_collection(name=collection_name)\n",
     "print(\"-> Tạo Database thành công!\")\n",
     "\n",
     "# 3. Dữ liệu văn bản mẫu\n",
     "van_ban_tho = \"\"\"\n",
     "THÔNG BÁO về việc nộp hồ sơ miễn, giảm học phí HKI năm học 2025 - 2026\n",
     "1. Đối với sinh viên được miễn (100%) học phí\n",
     "1.1 Người có công với cách mạng và thân nhân người có công với cách mạng...\n",
     "1.2 Sinh viên khuyết tật. Hồ sơ gồm: Đơn đề nghị miễn, giảm học phí; Giấy xác nhận khuyết tật...\n",
     "\"\"\"\n",
     "\n",
     "# 4. Thuật toán cắt nhỏ (Chunking)\n",
     "def chunk_text_fixed_size(text, chunk_size=100):\n",
     "    words = text.split()\n",
     "    chunks = []\n",
     "    for i in range(0, len(words), chunk_size):\n",
     "        chunks.append(\" \".join(words[i : i + chunk_size]))\n",
     "    return chunks\n",
     "\n",
     "danh_sach_chunks = chunk_text_fixed_size(van_ban_tho, chunk_size=100)\n",
     "\n",
     "# 5. Embedding và đưa vào CSDL\n",
     "print(\"Đang biến đổi văn bản thành Vector và lưu vào Database...\")\n",
     "for index, chunk in enumerate(danh_sach_chunks):\n",
     "    vector = embedding_model.encode(chunk).tolist()\n",
     "    collection.add(embeddings=[vector], documents=[chunk], ids=[f\"chunk_id_{index}\"])\n",
     "print(\"-> LƯU DỮ LIỆU THÀNH CÔNG!\")\n",
     "\"\"\"\n",
     "\n",
     "# Ghi nội dung vào tệp tin poc_rag_flow.py\n",
     "with open(\"poc_rag_flow.py\", \"w\", encoding=\"utf-8\") as f:\n",
     "    f.write(poc_code)\n",
     "\n",
     "print(\"Đã lưu file 'poc_rag_flow.py' thành công.\")\n",
     "\n",
     "# 3. Tiến hành kiểm tra, add, commit và push lên GitHub\n",
     "!git status\n",
     "!git add poc_rag_flow.py\n",
     "!git commit -m \"Thêm mã nguồn Python hoàn chỉnh của luồng PoC RAG\"\n",
     "!git push origin main"
    ],
