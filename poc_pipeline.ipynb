     "##Khởi tạo mô hình Embedding và Database\n"
    ],
    "metadata": {
     "id": "1QpznTRfdTAg"
    }
   },
   {
    "cell_type": "code",
    "source": [
     "import chromadb\n",
     "from sentence_transformers import SentenceTransformer\n",
     "\n",
     "# 1. Khởi tạo mô hình bge-m3 (Model chuẩn cho Tiếng Việt mà nhóm đã chốt)\n",
     "print(\"Đang tải mô hình bge-m3...\")\n",
     "embedding_model = SentenceTransformer('BAAI/bge-m3')\n",
     "print(\"-> Tải mô hình thành công!\")\n",
     "\n",
     "# 2. Khởi tạo ChromaDB lưu trữ cục bộ trên RAM của Colab\n",
     "print(\"\\nĐang khởi tạo Vector Database (ChromaDB)...\")\n",
     "chroma_client = chromadb.Client()\n",
     "\n",
     "# Xóa bảng cũ nếu đã tồn tại để tránh rác dữ liệu khi chạy lại nhiều lần\n",
     "collection_name = \"poc_van_ban_hoc_vu\"\n",
     "if collection_name in [c.name for c in chroma_client.list_collections()]:\n",
     "    chroma_client.delete_collection(name=collection_name)\n",
     "\n",
     "collection = chroma_client.create_collection(name=collection_name)\n",
     "print(\"-> Tạo Database thành công!\")"
    ],
