     "print(f\"Đã tạo tài liệu {workflow_filename} trong repository.\")\n",
     "\n",
     "# Thêm và commit tài liệu workflow mới\n",
     "!git add {workflow_filename}\n",
     "!git commit -m \"Add colab_git_workflow.md for Git integration guide\"\n",
     "!git push origin main\n",
     "\n",
     "print(f\"Đã đẩy tài liệu {workflow_filename} lên GitHub.\")"
